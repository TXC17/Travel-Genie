# ==============================================================================
# TRAVEL GENIE CONFIGURATION
# ==============================================================================

# Application Environment (development / production / testing)
ENVIRONMENT=development
DEBUG=True
APP_NAME="Travel Genie Backend"
APP_VERSION="1.0.0"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
# In Docker, use: postgresql+psycopg2://postgres:postgres@db:5432/travel_genie
# For local dev without Postgres, fallback to: sqlite:///./travel_genie.db
DATABASE_URL=sqlite:///./travel_genie.db

# JWT Authentication
SECRET_KEY=dev_insecure_secret_key_change_in_production_9f83ac6b39
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration (Google Gemini)
# The Gemini Flash model name is configurable and NOT hard-coded
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Map Configuration
MAP_DEFAULT_LAT=15.3350
MAP_DEFAULT_LNG=74.3188
MAP_DEFAULT_ZOOM=10

# Algorithmic Weights (Configurable MCDM scoring weights)
WEIGHT_INTEREST=0.35
WEIGHT_SEASON=0.25
WEIGHT_POPULARITY=0.15
WEIGHT_RATING=0.15
WEIGHT_BUDGET=0.10
